[2026-01-26 16:07:35] {"level":"INFO","event":"SQL_GET_REPORT","params":[],"query":"\r\n        SELECT\r\n            c.CODE02 AS unit,\r\n            c.DESC02 AS kelas,\r\n            c.DESC03 AS kelompok,\r\n            b.BTA AS tahun_akademik,\r\n            c.DESC04 AS tahun_angkatan,\r\n            d.KodePost AS kode_akun,\r\n            b.BILLCD AS kode_tagihan,\r\n            b.BILLNM AS nama_tagihan,\r\n            d.BILLAM AS jumlah,\r\n            ua.NamaAkun AS namapost,\r\n            c.NUM2ND AS no_pend,\r\n            c.NOCUST AS nis,\r\n            c.NMCUST AS nama,\r\n            b.PAIDDT AS tanggal,\r\n            b.FIDBANK AS fidbank\r\n        FROM scctbill_detail d\r\n        INNER JOIN scctbill b\r\n            ON b.BILLCD = d.BILLCD AND b.CUSTID = d.CUSTID\r\n        INNER JOIN scctcust c\r\n            ON c.CUSTID = b.CUSTID\r\n        LEFT JOIN u_akun ua\r\n            ON ua.KodeAkun = d.KodePost\r\n        WHERE b.PAIDST = 1\r\n          AND b.FSTSBolehBayar = 1\r\n     ORDER BY b.PAIDDT DESC, c.NOCUST ASC LIMIT 500 OFFSET 0 "}

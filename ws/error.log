[2026-01-21 15:47:35] {"level":"INFO","event":"SQL","params":{":from_dt":"2026-01-20 00:00:00",":to_dt":"2026-01-21 23:59:59"},"query":"\r\n        SELECT\r\n            c.CODE02 AS unit,\r\n            c.DESC02 AS kelas,\r\n            c.DESC03 AS kelompok,\r\n            c.DESC04 AS tahun_angkatan,\r\n            d.KodePost AS kode,\r\n            b.BILLNM AS nama_tagihan,\r\n            d.BILLAM AS jumlah,\r\n            ua.NamaAkun AS namapost,\r\n            c.NUM2ND AS no_pend,\r\n            c.NOCUST AS nis,\r\n            c.NMCUST AS nama,\r\n            COALESCE(b.PAIDDT, b.FTGLTagihan) AS tanggal\r\n        FROM scctbill_detail d\r\n        INNER JOIN scctbill b\r\n            ON b.BILLCD = d.BILLCD AND b.CUSTID = d.CUSTID\r\n        INNER JOIN scctcust c\r\n            ON c.CUSTID = b.CUSTID\r\n        LEFT JOIN u_akun ua\r\n            ON ua.KodeAkun = d.KodePost\r\n        WHERE 1=1\r\n    \r\n            AND (\r\n                (b.PAIDDT IS NOT NULL AND b.PAIDDT BETWEEN :from_dt AND :to_dt)\r\n                OR\r\n                (b.PAIDDT IS NULL AND b.FTGLTagihan BETWEEN :from_dt AND :to_dt)\r\n            )\r\n         ORDER BY tanggal DESC, nis ASC LIMIT :limit OFFSET :offset "}
